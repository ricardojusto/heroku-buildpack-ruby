#!/usr/bin/env bash
set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3
BUILDPACK_DIR=$(cd "$(dirname "$0")" || exit; pwd)

# Install our custom Ruby
source "$BUILDPACK_DIR/ruby_installer" "$BUILD_DIR" "$CACHE_DIR"

# Set up environment for the Ruby buildpack
export STACK="heroku-20" # or whatever stack you're using
export RUBY_VERSION="ruby-2.5.8"
export BUNDLER_VERSION="1.17.3"

# Create a fake metadata file to prevent the buildpack from complaining
mkdir -p "$CACHE_DIR/vendor/heroku"
echo "ruby-2.5.8" > "$CACHE_DIR/vendor/heroku/ruby_version"
echo "1.17.3" > "$CACHE_DIR/vendor/heroku/bundler_version"

# Set up PATH to use our custom Ruby
RUBY_PATH="$BUILD_DIR/vendor/ruby-2.5.8"
export PATH="$RUBY_PATH/bin:$PATH"

# Install our custom Bundler
source "$BUILDPACK_DIR/bundler_installer" "$BUILD_DIR" "$RUBY_PATH"

# Create a custom buildpack runner
cat > "$BUILD_DIR/custom_buildpack_runner.rb" << 'EOL'
require 'bundler/setup'
$:.unshift File.expand_path("../../lib", __FILE__)
require "language_pack"
require "language_pack/custom_ruby"

# Override the Ruby detector
LanguagePack::Installers::HerokuRubyInstaller.class_eval do
  def fetch_unpack(ruby_version_file_name, install_dir)
    # Skip the actual download since we've already installed our custom Ruby
    true
  end
end

# Override the outdated version check
LanguagePack::Helpers::OutdatedRubyVersion.class_eval do
  def call
    # Skip the outdated version check
  end
  
  def latest_minor_version?
    true
  end
  
  def maybe_eol?
    false
  end
  
  def eol?
    false
  end
end

# Run the buildpack
app = LanguagePack::CustomRuby.new(ARGV[0], ARGV[1])
app.compile
EOL

# Run our custom buildpack
ruby "$BUILD_DIR/custom_buildpack_runner.rb" "$BUILD_DIR" "$CACHE_DIR"

# Set up the runtime environment
mkdir -p "$BUILD_DIR/.profile.d"
cat > "$BUILD_DIR/.profile.d/ruby.sh" << EOL
export PATH="\$HOME/vendor/ruby-2.5.8/bin:\$HOME/bin:\$HOME/vendor/bundle/bin:\$PATH"
export GEM_PATH="\$HOME/vendor/ruby-2.5.8/lib/ruby/gems/2.5.0:\$GEM_PATH"
export BUNDLE_PATH="\$HOME/vendor/bundle"
export BUNDLE_WITHOUT="development:test"
export BUNDLE_DEPLOYMENT="1"
EOL

echo "-----> Custom Ruby buildpack completed"
