#!/usr/bin/env bash
set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

# Ruby version to install
RUBY_VERSION="2.5.8"
RUBY_DOWNLOAD_URL="https://cache.ruby-lang.org/pub/ruby/2.5/ruby-${RUBY_VERSION}.tar.gz"
RUBY_CACHE_DIR="$CACHE_DIR/ruby-$RUBY_VERSION"

# OpenSSL version and download URL
OPENSSL_VERSION="1.1.1h"
OPENSSL_DOWNLOAD_URL="https://github.com/openssl/openssl/releases/download/OpenSSL_1_1_1h/openssl-${OPENSSL_VERSION}.tar.gz"

# Zlib version and download URL
ZLIB_VERSION="1.3.1"
ZLIB_DOWNLOAD_URL="https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/zlib-${ZLIB_VERSION}.tar.gz"

echo "-----> Custom Ruby Buildpack: Preparing Ruby $RUBY_VERSION"

# Create the .heroku directory structure first
mkdir -p "$BUILD_DIR/.heroku/ruby"

# Check if Ruby is already cached
if [ -d "$RUBY_CACHE_DIR" ]; then
  echo "-----> Using cached Ruby $RUBY_VERSION"
  # Make sure the destination directory exists
  mkdir -p "$BUILD_DIR/.heroku/ruby"
  # Use cp -a to preserve permissions and timestamps
  cp -a "$RUBY_CACHE_DIR/." "$BUILD_DIR/.heroku/ruby/"
  # Verify the copy worked
  if [ ! -f "$BUILD_DIR/.heroku/ruby/bin/ruby" ]; then
    echo "Error: Ruby binary not found after copying from cache"
    echo "Contents of cache directory:"
    ls -la "$RUBY_CACHE_DIR"
    echo "Contents of destination directory:"
    ls -la "$BUILD_DIR/.heroku/ruby"
    exit 1
  fi
else
  echo "-----> Downloading Ruby $RUBY_VERSION"
  
  # Download and extract Ruby
  wget "${RUBY_DOWNLOAD_URL}" -O "ruby-${RUBY_VERSION}.tar.gz"
  if [ $? -ne 0 ]; then
    echo "Failed to download Ruby."
    exit 1
  fi

  tar -xzf "ruby-${RUBY_VERSION}.tar.gz"
  if [ $? -ne 0 ]; then
    echo "Failed to extract Ruby."
    exit 1
  fi

  # Check if the Ruby directory was created
  if [ ! -d "ruby-${RUBY_VERSION}" ]; then
    echo "Ruby directory does not exist. Extraction may have failed."
    exit 1
  fi

  # Store the original directory
  ORIGINAL_DIR=$(pwd)
  cd "ruby-${RUBY_VERSION}" || exit

  # Download OpenSSL using wget
  echo "-----> Downloading OpenSSL $OPENSSL_VERSION"
  wget "${OPENSSL_DOWNLOAD_URL}" -O "openssl-${OPENSSL_VERSION}.tar.gz"
  if [ $? -ne 0 ]; then
    echo "Failed to download OpenSSL."
    exit 1
  fi

  tar -xzf "openssl-${OPENSSL_VERSION}.tar.gz"
  if [ $? -ne 0 ]; then
    echo "Failed to extract OpenSSL."
    exit 1
  fi

  # Compile and install OpenSSL
  echo "-----> Compiling OpenSSL $OPENSSL_VERSION"
  cd "openssl-${OPENSSL_VERSION}" || exit
  # Make sure the destination directory exists
  mkdir -p "$BUILD_DIR/.heroku/libs/openssl"
  ./config --prefix="$BUILD_DIR/.heroku/libs/openssl"
  make
  if [ $? -ne 0 ]; then
    echo "Failed to compile OpenSSL."
    exit 1
  fi
  make install
  cd "$ORIGINAL_DIR/ruby-${RUBY_VERSION}" || exit  # Return to the Ruby directory

  # Download Zlib using wget
  echo "-----> Downloading Zlib $ZLIB_VERSION"
  wget "${ZLIB_DOWNLOAD_URL}" -O "zlib-${ZLIB_VERSION}.tar.gz"
  if [ $? -ne 0 ]; then
    echo "Failed to download Zlib."
    exit 1
  fi

  tar -xzf "zlib-${ZLIB_VERSION}.tar.gz"
  if [ $? -ne 0 ]; then
    echo "Failed to extract Zlib."
    exit 1
  fi

  # Compile and install Zlib
  echo "-----> Compiling Zlib $ZLIB_VERSION"
  cd "zlib-${ZLIB_VERSION}" || exit
  # Make sure the destination directory exists
  mkdir -p "$BUILD_DIR/.heroku/libs/zlib"
  ./configure --prefix="$BUILD_DIR/.heroku/libs/zlib"
  make
  if [ $? -ne 0 ]; then
    echo "Failed to compile Zlib."
    exit 1
  fi
  make install
  cd "$ORIGINAL_DIR/ruby-${RUBY_VERSION}" || exit  # Return to the Ruby directory

  # Set environment variables for the Ruby buildpack to find OpenSSL and Zlib
  export OPENSSL_DIR="$BUILD_DIR/.heroku/libs/openssl"
  export ZLIB_DIR="$BUILD_DIR/.heroku/libs/zlib"
  export LDFLAGS="-L$OPENSSL_DIR/lib -L$ZLIB_DIR/lib"
  export CPPFLAGS="-I$OPENSSL_DIR/include -I$ZLIB_DIR/include"

  echo "-----> Compiling Ruby $RUBY_VERSION"
  # Make sure the destination directory exists
  mkdir -p "$BUILD_DIR/.heroku/ruby"
  ./configure --prefix="$BUILD_DIR/.heroku/ruby" --with-openssl-dir="$OPENSSL_DIR" --with-zlib-dir="$ZLIB_DIR"
  make
  if [ $? -ne 0 ]; then
    echo "Failed to compile Ruby."
    exit 1
  fi
  make install

  # Verify Ruby was installed correctly
  if [ ! -f "$BUILD_DIR/.heroku/ruby/bin/ruby" ]; then
    echo "Error: Ruby binary not found after installation"
    echo "Contents of installation directory:"
    ls -la "$BUILD_DIR/.heroku/ruby"
    exit 1
  fi

  # Cache the compiled Ruby
  mkdir -p "$RUBY_CACHE_DIR"
  cp -a "$BUILD_DIR/.heroku/ruby/." "$RUBY_CACHE_DIR/"

  # Clean up
  cd "$ORIGINAL_DIR"
  rm -rf "ruby-${RUBY_VERSION}" "ruby-${RUBY_VERSION}.tar.gz"
fi

# Create a .ruby-version file to tell the official buildpack which Ruby to use
echo "ruby-2.5.8" > "$BUILD_DIR/.ruby-version"

# Verify Ruby installation
echo "-----> Verifying Ruby installation"
if [ -f "$BUILD_DIR/.heroku/ruby/bin/ruby" ]; then
  "$BUILD_DIR/.heroku/ruby/bin/ruby" --version
else
  echo "Ruby binary not found at expected location: $BUILD_DIR/.heroku/ruby/bin/ruby"
  echo "Contents of .heroku directory:"
  ls -la "$BUILD_DIR/.heroku"
  echo "Contents of .heroku/ruby directory (if it exists):"
  if [ -d "$BUILD_DIR/.heroku/ruby" ]; then
    ls -la "$BUILD_DIR/.heroku/ruby"
  else
    echo "Directory does not exist"
  fi
  exit 1
fi

# Fix shebangs in Ruby binaries
echo "-----> Fixing shebangs in Ruby binaries"
find "$BUILD_DIR/.heroku/ruby/bin" -type f -print0 | xargs -0 sed -i.bak '1s|^#!.*ruby$|#!/app/.heroku/ruby/bin/ruby|'

# Setup SSL certificates
echo "-----> Setting up SSL certificates"

# Create necessary directories
mkdir -p "$BUILD_DIR/.heroku/ruby/lib/ruby/2.5.0/rubygems/ssl_certs"
mkdir -p "$BUILD_DIR/.heroku/ruby/lib/ruby/site_ruby/2.5.0/rubygems/ssl_certs"
mkdir -p "$BUILD_DIR/.heroku/ruby/ssl/certs"

# Download the latest CA bundle from curl
echo "-----> Downloading CA certificates bundle"
wget -O "$BUILD_DIR/.heroku/ruby/ssl/cert.pem" "https://curl.se/ca/cacert.pem"
if [ $? -ne 0 ]; then
  echo "Failed to download CA certificates."
  exit 1
fi

# Copy the certificates to all possible locations Ruby might look for them
echo "-----> Copying CA certificates to Ruby SSL directories"
cp "$BUILD_DIR/.heroku/ruby/ssl/cert.pem" "$BUILD_DIR/.heroku/ruby/lib/ruby/2.5.0/rubygems/ssl_certs/cacert.pem"
cp "$BUILD_DIR/.heroku/ruby/ssl/cert.pem" "$BUILD_DIR/.heroku/ruby/ssl/certs/cacert.pem"
cp "$BUILD_DIR/.heroku/ruby/ssl/cert.pem" "$BUILD_DIR/.heroku/ruby/lib/ruby/site_ruby/2.5.0/rubygems/ssl_certs/cacert.pem" || true

# Set SSL_CERT_FILE environment variable for the build process
echo "-----> Setting SSL_CERT_FILE environment variable"
export SSL_CERT_FILE="$BUILD_DIR/.heroku/ruby/ssl/cert.pem"

# Create a .profile.d script to set SSL_CERT_FILE at runtime
echo "-----> Creating .profile.d script for SSL_CERT_FILE"
mkdir -p "$BUILD_DIR/.profile.d"
cat > "$BUILD_DIR/.profile.d/ruby_ssl.sh" <<EOF
# Set SSL certificate path
export SSL_CERT_FILE="\$HOME/.heroku/ruby/ssl/cert.pem"

# Set Ruby environment variables
export GEM_HOME="\$HOME/.heroku/ruby/lib/ruby/gems/2.5.0"
export GEM_PATH="\$HOME/.heroku/ruby/lib/ruby/gems/2.5.0"
export PATH="\$HOME/.heroku/ruby/bin:\$PATH"

# Set OpenSSL environment variables
export OPENSSL_CONF="\$HOME/.heroku/libs/openssl/openssl.cnf"
EOF

# Configure Bundler to use our SSL certificates
echo "-----> Configuring Bundler to use SSL certificates"
mkdir -p "$BUILD_DIR/.bundle"
cat > "$BUILD_DIR/.bundle/config" <<EOF
---
BUNDLE_SSL_CA_CERT: "$BUILD_DIR/.heroku/ruby/ssl/cert.pem"
BUNDLE_DISABLE_SHARED_GEMS: "true"
BUNDLE_PATH: "$BUILD_DIR/.heroku/ruby/lib/ruby/gems/2.5.0"
BUNDLE_BIN: "$BUILD_DIR/.heroku/ruby/bin"
EOF

# Update RubyGems to a version compatible with Ruby 2.5.8
echo "-----> Updating RubyGems to a compatible version"
unset BUNDLE_GEMFILE
SSL_CERT_FILE="$BUILD_DIR/.heroku/ruby/ssl/cert.pem" \
OPENSSL_CONF="$BUILD_DIR/.heroku/libs/openssl/openssl.cnf" \
"$BUILD_DIR/.heroku/ruby/bin/ruby" -r rubygems -S gem update --system 3.0.9 --no-document

# Install Bundler with SSL certificate path specified
echo "-----> Installing Bundler"
SSL_CERT_FILE="$BUILD_DIR/.heroku/ruby/ssl/cert.pem" \
OPENSSL_CONF="$BUILD_DIR/.heroku/libs/openssl/openssl.cnf" \
"$BUILD_DIR/.heroku/ruby/bin/gem" install bundler -v 1.17.3 --no-document


# Create metadata files for the buildpack
echo "-----> Creating metadata files"
mkdir -p "$CACHE_DIR/vendor/ruby"
mkdir -p "$CACHE_DIR/heroku-buildpack-ruby"

# Create a ruby_version cache file
echo "-----> Creating ruby_version cache file"
echo "ruby-2.5.8" > "$CACHE_DIR/ruby_version"

# Add Ruby to PATH for the rest of the build process
echo "-----> Adding Ruby to PATH"
export PATH="$BUILD_DIR/.heroku/ruby/bin:$PATH"
echo "$PATH"

# Now run the official Heroku Ruby buildpack
echo "-----> Custom Ruby installation complete. Continuing with modified Heroku Ruby buildpack..."
