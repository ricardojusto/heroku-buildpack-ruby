#!/usr/bin/env bash

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3
BIN_DIR=$(cd "$(dirname "$0")" || exit; pwd) # absolute path

# Ruby version to install
RUBY_VERSION="2.5.8"
RUBY_DOWNLOAD_URL="https://cache.ruby-lang.org/pub/ruby/2.5/ruby-${RUBY_VERSION}.tar.gz"
RUBY_CACHE_DIR="$CACHE_DIR/ruby-$RUBY_VERSION"

# Function to export environment variables from ENV_DIR
export_env_dir() {
  env_dir=$1
  if [ -d "$env_dir" ]; then
    for e in $(ls "$env_dir"); do
      export "$e=$(cat "$env_dir/$e")"
    done
  fi
}

# Export environment variables
export_env_dir "$ENV_DIR"

# Check if Ruby is already cached
if [ -d "$RUBY_CACHE_DIR" ]; then
  echo "-----> Using cached Ruby $RUBY_VERSION"
  cp -r "$RUBY_CACHE_DIR" "$BUILD_DIR/.heroku/ruby"
else
  echo "-----> Downloading Ruby $RUBY_VERSION"
  
  # Install dependencies
  echo "-----> Installing dependencies"
  apt-get update
  apt-get install -y build-essential libssl-dev libreadline-dev zlib1g-dev

  # Download and compile Ruby
  echo "-----> Downloading Ruby from $RUBY_DOWNLOAD_URL"
  curl -L "${RUBY_DOWNLOAD_URL}" -o "ruby-${RUBY_VERSION}.tar.gz"
  tar -xzvf "ruby-${RUBY_VERSION}.tar.gz"
  cd "ruby-${RUBY_VERSION}" || exit

  echo "-----> Compiling Ruby $RUBY_VERSION"
  ./configure --prefix="$BUILD_DIR/.heroku/ruby"
  make
  make install

  # Cache the compiled Ruby
  mkdir -p "$RUBY_CACHE_DIR"
  cp -r "$BUILD_DIR/.heroku/ruby"/* "$RUBY_CACHE_DIR"

  # Clean up
  cd ..
  rm -rf "ruby-${RUBY_VERSION}" "ruby-${RUBY_VERSION}.tar.gz"
fi

echo "-----> Ruby $RUBY_VERSION installed successfully"
