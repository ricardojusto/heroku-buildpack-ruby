#!/usr/bin/env bash
set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

echo "-----> Setting up RubyGems and Bundler"

# Set SSL certificate path for gem commands
export SSL_CERT_FILE="$BUILD_DIR/.heroku/ruby/ssl/cert.pem"

# First, make sure the SSL certificates directory exists
mkdir -p "$BUILD_DIR/.heroku/ruby/ssl/certs"

# Download the latest CA bundle from curl if it doesn't exist
if [ ! -f "$BUILD_DIR/.heroku/ruby/ssl/cert.pem" ]; then
  echo "-----> Downloading CA certificates bundle"
  wget -O "$BUILD_DIR/.heroku/ruby/ssl/cert.pem" "https://curl.se/ca/cacert.pem"
  if [ $? -ne 0 ]; then
    echo "Failed to download CA certificates."
    exit 1
  fi

  # Copy the certificates to all possible locations Ruby might look for them
  echo "-----> Copying CA certificates to Ruby SSL directories"
  mkdir -p "$BUILD_DIR/.heroku/ruby/lib/ruby/2.5.0/rubygems/ssl_certs"
  mkdir -p "$BUILD_DIR/.heroku/ruby/lib/ruby/site_ruby/2.5.0/rubygems/ssl_certs"
  
  cp "$BUILD_DIR/.heroku/ruby/ssl/cert.pem" "$BUILD_DIR/.heroku/ruby/lib/ruby/2.5.0/rubygems/ssl_certs/cacert.pem" || true
  cp "$BUILD_DIR/.heroku/ruby/ssl/cert.pem" "$BUILD_DIR/.heroku/ruby/ssl/certs/cacert.pem" || true
  cp "$BUILD_DIR/.heroku/ruby/ssl/cert.pem" "$BUILD_DIR/.heroku/ruby/lib/ruby/site_ruby/2.5.0/rubygems/ssl_certs/cacert.pem" || true
fi

# Create a .profile.d script to set SSL_CERT_FILE at runtime if it doesn't exist
if [ ! -f "$BUILD_DIR/.profile.d/ruby_ssl.sh" ]; then
  echo "-----> Creating .profile.d script for SSL_CERT_FILE"
  mkdir -p "$BUILD_DIR/.profile.d"
  cat > "$BUILD_DIR/.profile.d/ruby_ssl.sh" <<EOF
# Set SSL certificate path
export SSL_CERT_FILE="\$HOME/.heroku/ruby/ssl/cert.pem"

# Set Ruby environment variables
export GEM_HOME="\$HOME/.heroku/ruby/lib/ruby/gems/2.5.0"
export GEM_PATH="\$HOME/.heroku/ruby/lib/ruby/gems/2.5.0"
export PATH="\$HOME/.heroku/ruby/bin:\$PATH"
export RUBYLIB="\$HOME/.heroku/ruby/lib:\$HOME/.heroku/ruby/lib/ruby/2.5.0:\$HOME/.heroku/ruby/lib/ruby/2.5.0/x86_64-linux"
export RUBYOPT="-rrubygems"
EOF
  chmod +x "$BUILD_DIR/.profile.d/ruby_ssl.sh"
fi

# Configure Bundler to use our SSL certificates
echo "-----> Configuring Bundler to use SSL certificates"
mkdir -p "$BUILD_DIR/.bundle"
cat > "$BUILD_DIR/.bundle/config" <<EOF
---
BUNDLE_SSL_CA_CERT: "$BUILD_DIR/.heroku/ruby/ssl/cert.pem"
BUNDLE_DISABLE_SHARED_GEMS: "true"
BUNDLE_PATH: "$BUILD_DIR/.heroku/ruby/lib/ruby/gems/2.5.0"
BUNDLE_BIN: "$BUILD_DIR/.heroku/ruby/bin"
EOF

# Fix the shebang line in all Ruby executables
echo "-----> Fixing shebang lines in Ruby executables"
# First fix the gem executable specifically
if [ -f "$BUILD_DIR/app/.heroku/ruby/bin/gem" ]; then
  echo "-----> Fixing gem executable shebang"
  sed -i '1s|^#!.*ruby|#!/usr/bin/env ruby|' "$BUILD_DIR/app/.heroku/ruby/bin/gem"
  # Also create a copy in the expected location
  mkdir -p "$BUILD_DIR/.heroku/ruby/bin"
  cp "$BUILD_DIR/app/.heroku/ruby/bin/gem" "$BUILD_DIR/.heroku/ruby/bin/gem"
  chmod +x "$BUILD_DIR/.heroku/ruby/bin/gem"
else
  echo "Warning: gem executable not found at $BUILD_DIR/app/.heroku/ruby/bin/gem"
  # Try to find it
  find "$BUILD_DIR" -name gem -type f | xargs ls -la
fi

# Fix all other Ruby executables
find "$BUILD_DIR/app/.heroku/ruby/bin" -type f -exec sed -i '1s|^#!.*ruby|#!/usr/bin/env ruby|' {} \; 2>/dev/null || true
find "$BUILD_DIR/.heroku/ruby/bin" -type f -exec sed -i '1s|^#!.*ruby|#!/usr/bin/env ruby|' {} \; 2>/dev/null || true

# Set up environment for gem installation
export GEM_HOME="$BUILD_DIR/app/.heroku/ruby/lib/ruby/gems/2.5.0"
export GEM_PATH="$BUILD_DIR/app/.heroku/ruby/lib/ruby/gems/2.5.0"
export RUBYLIB="$BUILD_DIR/app/.heroku/ruby/lib:$BUILD_DIR/app/.heroku/ruby/lib/ruby/2.5.0:$BUILD_DIR/app/.heroku/ruby/lib/ruby/2.5.0/x86_64-linux"
export PATH="$BUILD_DIR/app/.heroku/ruby/bin:$PATH"

# Install Bundler directly using Ruby
echo "-----> Installing Bundler using Ruby"
BUNDLER_VERSION="1.17.3"
cd "$BUILD_DIR"

# Download bundler gem directly
mkdir -p "$BUILD_DIR/bundler-download"
cd "$BUILD_DIR/bundler-download"
wget "https://rubygems.org/downloads/bundler-${BUNDLER_VERSION}.gem"

# Install the downloaded gem using Ruby directly
"$BUILD_DIR/app/.heroku/ruby/bin/ruby" -e "require 'rubygems/installer'; Gem::Installer.new('bundler-${BUNDLER_VERSION}.gem', :ignore_dependencies => true).install"

cd "$BUILD_DIR"
rm -rf "$BUILD_DIR/bundler-download"

# Create bundler binstub
echo "-----> Creating bundler binstub"
mkdir -p "$BUILD_DIR/app/.heroku/ruby/bin"
cat > "$BUILD_DIR/app/.heroku/ruby/bin/bundle" <<EOF
#!/usr/bin/env ruby
# frozen_string_literal: true

#
# This file was generated by RubyGems.
#
# The application 'bundler' is installed as part of a gem, and
# this file is here to facilitate running it.
#

require 'rubygems'

version = ">= 0.a"

str = ARGV.first
if str
  str = str.b[/\A_(.*)_\z/, 1]
  if str and Gem::Version.correct?(str)
    version = str
    ARGV.shift
  end
end

if Gem.respond_to?(:activate_bin_path)
  load Gem.activate_bin_path('bundler', 'bundle', version)
else
  gem "bundler", version
  load Gem.bin_path("bundler", "bundle", version)
end
EOF
chmod +x "$BUILD_DIR/app/.heroku/ruby/bin/bundle"

# Also create the same binstub in the build directory
mkdir -p "$BUILD_DIR/.heroku/ruby/bin"
cp "$BUILD_DIR/app/.heroku/ruby/bin/bundle" "$BUILD_DIR/.heroku/ruby/bin/bundle"
chmod +x "$BUILD_DIR/.heroku/ruby/bin/bundle"

# Create a symlink to ensure bundle is in PATH
ln -sf "$BUILD_DIR/app/.heroku/ruby/bin/bundle" "$BUILD_DIR/app/.heroku/ruby/bin/bundler"
ln -sf "$BUILD_DIR/.heroku/ruby/bin/bundle" "$BUILD_DIR/.heroku/ruby/bin/bundler"

echo "-----> RubyGems and Bundler setup complete"
